          "queries": [
            {
              "sql": "SELECT \n    s.station_id,\n    COUNT(CASE WHEN t.start_station_id = s.station_id THEN 1 END) as departures,\n    COUNT(CASE WHEN t.end_station_id = s.station_id THEN 1 END) as arrivals,\n    COUNT(CASE WHEN t.start_station_id = s.station_id THEN 1 END) - COUNT(CASE WHEN t.end_station_id = s.station_id THEN 1 END) as net_departures\nFROM stations s\nLEFT JOIN trips t ON (t.start_station_id = s.station_id OR t.end_station_id = s.station_id)\nWHERE EXTRACT(DOW FROM t.started_at) BETWEEN 1 AND 5\n  AND EXTRACT(HOUR FROM t.started_at) >= 7\n  AND EXTRACT(HOUR FROM t.started_at) < 10\n  AND EXTRACT(YEAR FROM t.started_at) = 2025\nGROUP BY s.station_id\nORDER BY net_departures DESC, s.station_id ASC\nLIMIT 5;",
